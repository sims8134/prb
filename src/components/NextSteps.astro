---
// "What next": the two exit points of the site, defined once.
// Home: full size, right after the latest video. Other content pages: compact, just
// before the footer (added by MainLayout). Not on the legal and privacy pages.
// Plain links, nothing is requested from the two external sites before a click.
import type { Lang } from "../data/site";
import { nextSteps, coldWarBulgariaUrl, DEEPER_ANCHORS, BUY_ME_A_COFFEE_URL, type DeeperPage } from "../data/next-steps";

interface Props {
  lang: Lang;
  compact?: boolean;
  /** Page of origin: picks the "Go deeper" variant (history, collection, tourism) and tags the link. */
  page?: string;
}
const { lang, compact = false, page = "home" } = Astro.props;
const n = nextSteps[lang] ?? nextSteps.en;
const anchor = DEEPER_ANCHORS[page as DeeperPage];
const deeper = anchor ? { ...n.deeper, ...n.deeperFor[page as DeeperPage] } : n.deeper;
const deeperHref = coldWarBulgariaUrl(page, anchor);
---

<section class:list={["next-steps", { "is-compact": compact }]} aria-label={n.label}>
  <article class="ns-card ns-card--deeper">
    <div class="ns-head">
      <span class="ns-icon" aria-hidden="true">
        <!-- folded map with a pin: timeline, museum, map -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6 9 4z" /><path d="M9 4v14M15 6v6" /><path d="M18 15.5c0 1.6-2 3.5-2 3.5s-2-1.9-2-3.5a2 2 0 0 1 4 0z" /></svg>
      </span>
      <h2>{deeper.title}</h2>
    </div>
    <p>{deeper.text}</p>
    <div class="ns-action">
      <a class="btn-red" href={deeperHref} target="_blank" rel="noopener">
        {deeper.button}
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        <span class="sr-only">({n.newTab})</span>
      </a>
      <span class="ns-domain" aria-hidden="true">coldwarbulgaria.com</span>
    </div>
  </article>

  <article class="ns-card ns-card--coffee">
    <div class="ns-head">
      <span class="ns-icon" aria-hidden="true">
        <!-- the cup of the footer link, with its steam -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9z" /><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17" /><path class="ns-steam" d="M8 3.5c-.6.8.6 1.2 0 2M12 3.5c-.6.8.6 1.2 0 2" /></svg>
      </span>
      <h2>{n.coffee.title}</h2>
    </div>
    <p>{n.coffee.text}</p>
    <div class="ns-action">
      <a class="btn-red" href={BUY_ME_A_COFFEE_URL} target="_blank" rel="noopener">
        {n.coffee.button}
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        <span class="sr-only">({n.newTab})</span>
      </a>
    </div>
  </article>
</section>

<style>
  .next-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-8);
  }
  .ns-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(2.4rem, 3.5vw, 3.6rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .ns-card:hover, .ns-card:focus-within { border-color: var(--accent); box-shadow: var(--shadow-hover); }
  .ns-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .ns-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text);
  }
  .ns-icon svg { width: 22px; height: 22px; }
  .ns-card h2 {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.2rem, 2.4vw, 2.6rem);
    line-height: 1.2;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text);
  }
  .ns-card p {
    max-width: 52ch;
    font-size: 1.6rem;
    line-height: 1.65;
    color: var(--text-2);
    margin-bottom: var(--s-5);
  }
  .ns-action {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }
  .ns-domain {
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }
  /* small detail: the steam of the cup rises when the card is hovered */
  .ns-steam { transition: transform 0.6s var(--ease), opacity 0.6s var(--ease); }
  .ns-card--coffee:hover .ns-steam { transform: translateY(-1.5px); opacity: 0.6; }

  /* Compact: bottom of the inner pages, quieter than on the home page */
  .is-compact { gap: var(--s-4); }
  .is-compact .ns-card { padding: var(--s-5); box-shadow: none; }
  .is-compact .ns-head { margin-bottom: var(--s-2); }
  .is-compact .ns-icon { width: 36px; height: 36px; }
  .is-compact .ns-icon svg { width: 18px; height: 18px; }
  .is-compact h2 { font-size: 1.9rem; }
  .is-compact p { font-size: 1.5rem; margin-bottom: var(--s-4); }

  @media (max-width: 760px) {
    .next-steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .ns-action .btn-red, .ns-action .btn-secondary { width: 100%; }
    .ns-domain { width: 100%; text-align: center; }
  }
</style>
