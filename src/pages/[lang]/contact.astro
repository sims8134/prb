---
import MainLayout from "../../layouts/MainLayout.astro";
import { noIcon } from "../../lib/text";
import "../../styles/content.css";
import {
  supportedLangs,
  siteContent,
  getLangFromParams,
  buildNav,
  buildFooter,
} from "../../data/site";

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromParams(Astro.params.lang);
const t = siteContent[lang];

const copy = {
  en: {
    title: "Contact",
    subtitle: "A question? A request? A suggestion? Don't hesitate to get in touch!",
    emailTitle: "Email",
    emailText: "For any question about the collection, tourism, the store or the website:",
    follow: "Follow us",
    igText: "Instagram: Photos, collection, urbex",
    ytText: "YouTube: videos, urbex, edits",
    fbText: "Facebook Page",
  },
  fr: {
    title: "Contact",
    subtitle: "Une question ? Une demande ? Une suggestion ? N'hésitez pas à me contacter !",
    emailTitle: "Email",
    emailText: "Pour toute question concernant la collection, le tourisme, la boutique ou le site :",
    follow: "Suivez-nous",
    igText: "Instagram : Photos, collection, urbex",
    ytText: "YouTube : vidéos, urbex, montages",
    fbText: "Page Facebook",
  },
  es: {
    title: "Contacto",
    subtitle: "¿Una pregunta? ¿Una solicitud? ¿Una sugerencia? ¡No dudes en ponerte en contacto!",
    emailTitle: "Email",
    emailText: "Para cualquier pregunta sobre la colección, el turismo, la tienda o el sitio web:",
    follow: "Síguenos",
    igText: "Instagram: Fotos, colección, urbex",
    ytText: "YouTube: vídeos, urbex, edits",
    fbText: "Página de Facebook",
  },
  bg: {
    title: "Контакт",
    subtitle: "Въпрос? Запитване? Предложение? Не се колебайте да се свържете!",
    emailTitle: "Имейл",
    emailText: "За въпроси относно колекцията, туризма, магазина или уебсайта:",
    follow: "Последвайте ни",
    igText: "Instagram: Снимки, колекция, urbex",
    ytText: "YouTube: видеа, urbex, монтажи",
    fbText: "Facebook страница",
  },
}[lang];
---

<MainLayout
  lang={lang}
  title={t.contact.title}
  description={t.contact.description}
  nav={buildNav(lang, t)}
  footer={buildFooter(lang, t)}
  active="contact"
  heroImage="/home/BackGroundHome.jpg"
>

<style>
/* Shared rules (title, lead, cards, links): src/styles/content.css. */
.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: var(--s-5);
  align-items: stretch;
}
.contact-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--s-3);
  padding: clamp(2.4rem, 3.5vw, 3.6rem);
  text-align: center;
}
.contact-card h2,
.socials-card h2 {
  font-family: 'Oswald', sans-serif;
  font-size: 2.2rem;
  line-height: 1.2;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text);
}
.contact-card p {
  max-width: 44ch;
  font-size: 1.55rem;
  line-height: 1.7;
  color: var(--text-2);
}
.contact-card .plain-link {
  font-family: 'Oswald', sans-serif;
  font-size: 1.8rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.socials-card { padding: clamp(2.4rem, 3.5vw, 3.6rem); }
.socials-card h2 { margin-bottom: var(--s-4); }
.social-list { display: grid; gap: var(--s-3); }
.social-item {
  display: flex;
  align-items: center;
  gap: var(--s-4);
  padding: var(--s-3) var(--s-4);
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
}
.social-item:hover,
.social-item:focus-visible { border-color: var(--accent); transform: translateY(-2px); }
.social-item img { height: 26px; width: 32px; object-fit: contain; flex: none; }
.social-item div { min-width: 0; }
.social-item strong {
  display: block;
  font-size: 1.5rem;
  color: var(--text);
  overflow-wrap: anywhere;
}
.social-item span { font-size: 1.4rem; color: var(--text-3); }
.newsletter-box {
  margin-top: var(--s-5);
  padding: clamp(2.4rem, 4vw, 4rem);
}
.newsletter-box h2 { margin-top: 0; }
.newsletter-text {
  max-width: 62ch;
  font-size: 1.6rem;
  line-height: 1.7;
  color: var(--text-2);
  margin-bottom: var(--s-5);
}
.newsletter-form {
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
  align-items: flex-start;
  max-width: 560px;
}
.newsletter-form input[type="email"] {
  width: 100%;
  min-height: 48px;
  background: var(--bg);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-family: 'Roboto', sans-serif;
  font-size: 1.6rem;
  padding: 1rem 1.4rem;
  transition: border-color 0.2s var(--ease);
}
.newsletter-form input[type="email"]::placeholder { color: var(--text-3); }
.newsletter-form input[type="email"]:focus { border-color: var(--text-2); }
.newsletter-consent {
  display: flex;
  align-items: flex-start;
  gap: var(--s-3);
  font-size: 1.45rem;
  line-height: 1.6;
  color: var(--text-2);
  margin-bottom: var(--s-2);
}
.newsletter-consent input { width: 20px; height: 20px; margin-top: 2px; flex: 0 0 auto; accent-color: var(--accent); }
.form-feedback { margin-top: var(--s-4); font-size: 1.5rem; line-height: 1.6; color: var(--text-2); }
.form-feedback:empty { display: none; }
.form-feedback.success { color: #9ad3a5; }
.form-feedback.error { color: var(--accent-text); }
.form-feedback .hint { font-size: 1.35rem; color: var(--text-3); }
@media (min-width: 900px) {
  .newsletter-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    column-gap: var(--s-7);
    grid-template-rows: auto 1fr auto;
    align-items: start;
  }
  .newsletter-box h2, .newsletter-box .newsletter-text { grid-column: 1; }
  .newsletter-box .newsletter-form { grid-column: 2; grid-row: 1 / span 2; max-width: none; }
  .newsletter-box .form-feedback { grid-column: 2; grid-row: 3; }
}
@media (max-width: 800px) {
  .contact-grid { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .newsletter-form .btn-red { width: 100%; }
  .social-item strong { font-size: 1.3rem; overflow-wrap: normal; }
}
</style>

<div class="page-wrap">
  <h1 class="page-title">{copy.title}</h1>
  <p class="page-subtitle">{copy.subtitle}</p>

  <div class="contact-grid">
  <div class="contact-card content-card">
    <span class="content-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5 12 13l8.5-6.5" /></svg></span>
    <h2>{copy.emailTitle}</h2>
    <p>{copy.emailText}</p>
    <a href="mailto:contact@peoplesrepublicofbulgaria.com" class="plain-link">
      contact@peoplesrepublicofbulgaria.com
    </a>
  </div>

  <div class="socials-card content-card">
    <h2>{copy.follow}</h2>
    <div class="social-list">
      <a href="https://www.instagram.com/peoplesrepublicofbulgaria/" target="_blank" rel="noopener noreferrer" class="social-item">
        <img src="/png/instagram.webp" alt="Instagram" />
        <div>
          <strong>@peoplesrepublicofbulgaria</strong>
          <span>{copy.igText}</span>
        </div>
      </a>

      <a href="https://www.youtube.com/@PeoplesRepublicOfBulgaria1505" target="_blank" rel="noopener noreferrer" class="social-item">
        <img src="/png/Youtube_logo.png" alt="YouTube" />
        <div>
          <strong>@PeoplesRepublicOfBulgaria1505</strong>
          <span>{copy.ytText}</span>
        </div>
      </a>

      <a href="https://www.facebook.com/PeoplesRepublicOfBulgaria/" target="_blank" rel="noopener noreferrer" class="social-item">
        <img src="/png/facebook.png" alt="Facebook" />
        <div>
          <strong>People's Republic Of Bulgaria</strong>
          <span>{copy.fbText}</span>
        </div>
      </a>
      <a href="https://www.tiktok.com/@peoplesrepublicof70" target="_blank" rel="noopener noreferrer" class="social-item">
        <img src="/png/Tiktok_icon.png" alt="TikTok" />
        <div>
          <strong>@peoplesrepublicof70</strong>
          <span>TikTok</span>
        </div>
      </a>
    </div>
  </div>
  </div>
  <div class="newsletter-box content-card">
    <h2 class="content-h2">{t.home.newsletter.title}</h2>
    <p class="newsletter-text">{t.home.newsletter.text}</p>

    <form id="newsletter-form" action="/api/newsletter" method="POST" class="newsletter-form"
      data-subscribing={t.home.newsletter.subscribing}
      data-success={noIcon(t.home.newsletter.success)}
      data-success-hint={t.home.newsletter.successHint}
      data-error={noIcon(t.home.newsletter.error)}
      data-error-network={noIcon(t.home.newsletter.errorNetwork)}
      data-error-rate-limit={noIcon(t.home.newsletter.errorRateLimit)}
    >
      <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <label class="sr-only" for="contact-newsletter-email">{t.home.newsletter.placeholder}</label>
      <input type="email" name="email" id="contact-newsletter-email" placeholder={t.home.newsletter.placeholder} required />
      <label class="newsletter-consent">
        <input type="checkbox" name="consent" required />
        {t.home.newsletter.consent}
      </label>
      <button type="submit" class="btn-red">{t.home.newsletter.button}</button>
    </form>
    <div id="newsletter-feedback" class="form-feedback" role="status" aria-live="polite"></div>
  </div>
</div>

<script>
  const newsletterForm = document.getElementById("newsletter-form");
  const newsletterFeedback = document.getElementById("newsletter-feedback");
  const newsletterLoadedAt = performance.now();

  newsletterForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const msgs = {
      subscribing: newsletterForm.dataset.subscribing,
      success: newsletterForm.dataset.success,
      successHint: newsletterForm.dataset.successHint,
      error: newsletterForm.dataset.error,
      errorNetwork: newsletterForm.dataset.errorNetwork,
      errorRateLimit: newsletterForm.dataset.errorRateLimit,
    };

    newsletterFeedback.textContent = msgs.subscribing;
    newsletterFeedback.className = "form-feedback";

    const formData = new FormData(newsletterForm);
    formData.set("elapsed_ms", String(Math.round(performance.now() - newsletterLoadedAt)));

    try {
      const res = await fetch("/api/newsletter", {
        method: "POST",
        body: formData,
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        newsletterFeedback.innerHTML = `
          ${msgs.success}<br>
          <span class="hint">${msgs.successHint}</span>
        `;
        newsletterFeedback.className = "form-feedback success";
        newsletterForm.reset();
      } else if (res.status === 429) {
        newsletterFeedback.textContent = msgs.errorRateLimit;
        newsletterFeedback.className = "form-feedback error";
      } else if (res.status >= 500) {
        newsletterFeedback.textContent = msgs.error;
        newsletterFeedback.className = "form-feedback error";
      } else {
        newsletterFeedback.textContent = data.error || msgs.error;
        newsletterFeedback.className = "form-feedback error";
      }
    } catch {
      newsletterFeedback.textContent = msgs.errorNetwork;
      newsletterFeedback.className = "form-feedback error";
    }
  });
</script>
</MainLayout>
