---
import MainLayout from "../../layouts/MainLayout.astro";
import {
  supportedLangs,
  siteContent,
  getLangFromParams,
  buildNav,
  buildFooter,
} from "../../data/site";
import { getPlaylistVideos } from "../../data/youtube";
import VideoFacade from "../../components/VideoFacade.astro";
import { thumbFor, CARD_WIDTHS, FEATURED_WIDTHS } from "../../lib/video-thumbs";
import "../../styles/content.css";

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromParams(Astro.params.lang);
const t = siteContent[lang];

const copy = {
  en: {
    title: "Videos",
    subtitle: "All videos organised by category. Click a thumbnail to load it in the player.",
    subscribeTitle: "Subscribe to the Channel",
    subscribeText: "New videos regularly. Don't miss anything about the People's Republic of Bulgaria.",
    subscribeBtn: "Subscribe on YouTube",
    more: "More videos from this category",
    watch: "Watch on YouTube",
    playlist: "Full Playlist",
    empty: "No videos found in this playlist yet.",
  },
  fr: {
    title: "Vidéos",
    subtitle: "Toutes les vidéos classées par catégorie. Cliquez sur une miniature pour la charger dans le lecteur.",
    subscribeTitle: "S'abonner à la chaîne",
    subscribeText: "De nouvelles vidéos régulièrement. Ne manquez rien sur la République populaire de Bulgarie.",
    subscribeBtn: "S'abonner sur YouTube",
    more: "Plus de vidéos de cette catégorie",
    watch: "Voir sur YouTube",
    playlist: "Playlist complète",
    empty: "Aucune vidéo trouvée dans cette playlist pour le moment.",
  },
  es: {
    title: "Vídeos",
    subtitle: "Todos los vídeos organizados por categoría. Haz clic en una miniatura para cargarla en el reproductor.",
    subscribeTitle: "Suscribirse al canal",
    subscribeText: "Nuevos vídeos regularmente. No te pierdas nada sobre la República Popular de Bulgaria.",
    subscribeBtn: "Suscribirse en YouTube",
    watch: "Ver en YouTube",
    playlist: "Lista completa",
    more: "Más vídeos de esta categoría",
    empty: "Todavía no se han encontrado vídeos en esta lista.",
  },
  bg: {
    title: "Видеа",
    subtitle: "Всички видеа са организирани по категории. Натиснете върху миниатюра, за да я заредите в плеъра.",
    subscribeTitle: "Абонирай се за канала",
    subscribeText: "Нови видеа редовно. Не пропускайте нищо за Народна република България.",
    subscribeBtn: "Абонирай се в YouTube",
    watch: "Гледай в YouTube",
    playlist: "Цял плейлист",
    more: "Още видеа от тази категория",
    empty: "Все още няма намерени видеа в този плейлист.",
  },
}[lang];

const playlistMap = [
  {
    key: "urbex",
    playlistId: import.meta.env.PLAYLIST_URBEX,
    playlistLabel: "Urbex",
    title: {
      en: "Urbex: Abandoned Communist Bulgaria",
      fr: "Urbex : Bulgarie communiste abandonnée",
      es: "Urbex: Bulgaria comunista abandonada",
      bg: "Urbex: Изоставена комунистическа България",
    },
    text: {
      en: "Exploring forgotten buildings, military bases and ghost sites from the communist era.",
      fr: "Exploration de bâtiments oubliés, bases militaires et lieux fantômes de l'époque communiste.",
      es: "Exploración de edificios olvidados, bases militares y lugares fantasma de la era comunista.",
      bg: "Изследване на забравени сгради, военни бази и призрачни места от комунистическата епоха.",
    },
  },
  {
    key: "edit",
    playlistId: import.meta.env.PLAYLIST_EDIT,
    playlistLabel: "Edit",
    title: {
      en: "Edit: Cinematic Communist Bulgaria",
      fr: "Edit : Bulgarie communiste cinématique",
      es: "Edit: Bulgaria comunista cinematográfica",
      bg: "Edit: Кинематографична комунистическа България",
    },
    text: {
      en: "Atmospheric edits with archive footage, music and cold war atmosphere.",
      fr: "Montages d'ambiance avec archives, musique et atmosphère guerre froide.",
      es: "Edits atmosféricos con archivos, música y ambiente de Guerra Fría.",
      bg: "Атмосферни монтажи с архивни кадри, музика и дух на Студената война.",
    },
  },
  {
    key: "unboxing",
    playlistId: import.meta.env.PLAYLIST_UNBOXING,
    playlistLabel: "Unboxing",
    title: {
      en: "Unboxing: Communist Era Objects",
      fr: "Unboxing : Objets de l'époque communiste",
      es: "Unboxing: Objetos de la era comunista",
      bg: "Unboxing: Предмети от комунистическата епоха",
    },
    text: {
      en: "Flea market finds, rare military items, propaganda objects: detailed unboxings of historical artefacts.",
      fr: "Trouvailles de brocante, objets militaires rares, propagande : déballages détaillés d'artefacts historiques.",
      es: "Hallazgos de mercadillo, objetos militares raros, propaganda: unboxings detallados de artefactos históricos.",
      bg: "Находки от битпазари, редки военни предмети, пропаганда: детайлни представяния на исторически артефакти.",
    },
  },
  {
    key: "presentation",
    playlistId: import.meta.env.PLAYLIST_PRESENTATION,
    playlistLabel: "Presentation",
    title: {
      en: "Presentation: Detailed Object Reviews",
      fr: "Présentation : Objets en détail",
      es: "Presentación: Reseñas detalladas de objetos",
      bg: "Представяне: Подробни ревюта на предмети",
    },
    text: {
      en: "In-depth presentations of medals, uniforms, badges, documents, with historical context.",
      fr: "Présentations détaillées de médailles, uniformes, insignes, documents, avec contexte historique.",
      es: "Presentaciones detalladas de medallas, uniformes, insignias y documentos, con contexto histórico.",
      bg: "Подробни представяния на медали, униформи, значки и документи, с исторически контекст.",
    },
  },
  {
    key: "tourism",
    playlistId: import.meta.env.PLAYLIST_TOURISM,
    playlistLabel: "Tourism",
    title: {
      en: "Tourism: Communist Heritage Sites",
      fr: "Tourisme : Sites patrimoniaux communistes",
      es: "Turismo: Lugares patrimoniales comunistas",
      bg: "Туризъм: Комунистически исторически обекти",
    },
    text: {
      en: "Guided visits to monuments, museums and communist-era sites across Bulgaria.",
      fr: "Visites guidées de monuments, musées et sites de l'époque communiste à travers la Bulgarie.",
      es: "Visitas guiadas a monumentos, museos y lugares de la época comunista en Bulgaria.",
      bg: "Обиколки на паметници, музеи и обекти от комунистическата епоха в България.",
    },
  },
];

const playLabel = { en: "Play", fr: "Lecture", es: "Reproducir", bg: "Пусни" }[lang];
const watchText = {
  en: "Watch this video →",
  fr: "Voir cette vidéo →",
  es: "Ver este vídeo →",
  bg: "Гледай това видео →",
}[lang];
const carouselLabels = {
  en: { prev: "Previous videos", next: "Next videos" },
  fr: { prev: "Vidéos précédentes", next: "Vidéos suivantes" },
  es: { prev: "Vídeos anteriores", next: "Vídeos siguientes" },
  bg: { prev: "Предишни видеа", next: "Следващи видеа" },
}[lang];

// Thumbnails are files of this domain prepared at build time (src/lib/video-thumbs.ts).
const categories = await Promise.all(
  playlistMap.map(async (cat) => {
    const videos = cat.playlistId ? await getPlaylistVideos(cat.playlistId) : [];
    const featured = videos[0] ?? null;
    return {
      key: cat.key,
      playlistId: cat.playlistId,
      playlistLabel: cat.playlistLabel,
      title: cat.title[lang],
      text: cat.text[lang],
      featured,
      featuredThumb: featured ? await thumbFor(featured.videoId, FEATURED_WIDTHS) : null,
      cards: await Promise.all(videos.slice(1).map(async (video) => ({ video, thumb: await thumbFor(video.videoId, CARD_WIDTHS) }))),
    };
  })
);
---

<MainLayout
  lang={lang}
  title={t.videos.title}
  description={t.videos.description}
  nav={buildNav(lang, t)}
  footer={buildFooter(lang, t)}
  active="videos"
  heroImage="/home/BackGroundHome.jpg"
>

<style>
/* Shared rules (title, lead, section titles, cards): src/styles/content.css. */
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin-bottom: var(--s-5);
}
.tab-panel { display: none; }
.tab-panel.active { display: block; }

.player-box {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  gap: var(--s-5);
  align-items: center;
  padding: var(--s-4);
}
.player-embed {
  position: relative;
  aspect-ratio: 16 / 9;
  background: #000;
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.player-meta { padding: var(--s-2) var(--s-3) var(--s-2) 0; }
.player-meta h2 {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(2rem, 2.2vw, 2.4rem);
  line-height: 1.2;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text);
  margin-bottom: var(--s-3);
}
.player-meta p {
  font-size: 1.55rem;
  line-height: 1.7;
  color: var(--text-2);
  margin-bottom: var(--s-5);
}
.player-links { display: flex; flex-wrap: wrap; gap: var(--s-3); }

.carousel-wrap { position: relative; margin-bottom: var(--s-5); }
.carousel-track {
  display: flex;
  gap: var(--s-4);
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x proximity;
  scrollbar-width: none;
  padding: var(--s-1) var(--s-1) var(--s-4);
}
.carousel-track::-webkit-scrollbar { display: none; }
.thumb-card {
  flex: 0 0 300px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  scroll-snap-align: start;
}
.thumb-media {
  position: relative;
  aspect-ratio: 16 / 9;
  background: #000;
}
.thumb-body {
  flex: 1;
  padding: var(--s-4);
  cursor: pointer;
}
.thumb-body h3 {
  font-family: 'Oswald', sans-serif;
  font-size: 1.6rem;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--text);
  margin-bottom: var(--s-2);
}
.thumb-body p { font-size: 1.35rem; color: var(--text-3); }
.carousel-btn {
  position: absolute;
  top: calc(50% - var(--s-4));
  transform: translateY(-50%);
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  border: 1px solid var(--line-strong);
  background: rgba(17, 18, 20, 0.88);
  color: var(--text);
  cursor: pointer;
  transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
}
.carousel-btn svg { width: 22px; height: 22px; }
.carousel-btn:hover,
.carousel-btn:focus-visible { background: var(--accent); border-color: var(--accent); color: #fff; }
.carousel-btn.prev { left: -10px; }
.carousel-btn.next { right: -10px; }
@media (min-width: 1300px) {
  .carousel-btn.prev { left: -58px; }
  .carousel-btn.next { right: -58px; }
}

.empty-box { padding: var(--s-5); font-size: 1.55rem; color: var(--text-2); }

.subscribe-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-3);
  max-width: 820px;
  margin: var(--s-7) auto 0;
  padding: clamp(2.4rem, 4vw, 4rem);
  text-align: center;
}
.subscribe-box h2 {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(2.2rem, 2.6vw, 2.8rem);
  line-height: 1.2;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent);
}
.subscribe-box p {
  max-width: 60ch;
  font-size: 1.6rem;
  line-height: 1.7;
  color: var(--text-2);
  margin-bottom: var(--s-2);
}

@media (max-width: 900px) {
  .player-box { grid-template-columns: 1fr; }
  .player-meta { padding: 0 var(--s-2) var(--s-2); }
}
@media (max-width: 560px) {
  .thumb-card { flex-basis: 82%; }
  .carousel-btn { display: none; } /* swipe on phones */
  .player-links > * { flex: 1 1 auto; }
}
</style>

<div class="page-wrap">
  <h1 class="page-title">{copy.title}</h1>
  <p class="page-subtitle">{copy.subtitle}</p>

  <div class="tabs" role="group" aria-label={copy.title}>
    {categories.map((cat, index) => (
      <button
        type="button"
        class:list={["tab-btn", index === 0 ? "btn-red" : "btn-secondary"]}
        data-tab={cat.key}
        aria-controls={`tab-${cat.key}`}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        {cat.playlistLabel}
      </button>
    ))}
  </div>

  {categories.map((cat, index) => (
    <div class:list={["tab-panel", { active: index === 0 }]} id={`tab-${cat.key}`}>
      {cat.featured ? (
        <>
          <div class="player-box content-card">
            <div class="player-embed">
              <VideoFacade
                video={{ id: cat.featured.videoId, title: cat.featured.title }}
                playLabel={playLabel}
                thumb={cat.featuredThumb}
                sizes="(min-width: 1180px) 680px, (min-width: 901px) 58vw, 100vw"
                eager={index === 0}
              />
            </div>

            <div class="player-meta">
              <h2>{cat.title}</h2>
              <p>{cat.text}</p>
              <div class="player-links">
                <a href={`https://www.youtube.com/watch?v=${cat.featured.videoId}`} target="_blank" rel="noopener noreferrer" class="btn-red">
                  <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
                  {copy.watch}
                </a>
                <a href={`https://www.youtube.com/playlist?list=${cat.playlistId}`} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
                  {copy.playlist}
                </a>
              </div>
            </div>
          </div>

          {cat.cards.length > 0 && (
            <>
              <p class="section-label">{copy.more}</p>

              <div class="carousel-wrap">
                <button type="button" class="carousel-btn prev" data-carousel={cat.key} aria-label={carouselLabels.prev}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                </button>
                <div class="carousel-track" id={`carousel-${cat.key}`}>
                  {cat.cards.map(({ video, thumb }) => (
                    <div class="thumb-card content-card">
                      <div class="thumb-media">
                        <VideoFacade
                          video={{ id: video.videoId, title: video.title }}
                          playLabel={playLabel}
                          thumb={thumb}
                          sizes="(max-width: 560px) 82vw, 300px"
                        />
                      </div>
                      <div class="thumb-body" data-play-card>
                        <h3>{video.title}</h3>
                        <p>{watchText}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <button type="button" class="carousel-btn next" data-carousel={cat.key} aria-label={carouselLabels.next}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
              </div>
            </>
          )}
        </>
      ) : (
        <div class="empty-box content-card">{copy.empty}</div>
      )}
    </div>
  ))}

  <div class="subscribe-box content-card">
    <h2>{copy.subscribeTitle}</h2>
    <p>{copy.subscribeText}</p>
    <a href="https://www.youtube.com/@PeoplesRepublicOfBulgaria1505" target="_blank" rel="noopener noreferrer" class="btn-red">
      <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
      {copy.subscribeBtn}
    </a>
  </div>
</div>

<script>
  // Tabs: the selected category is the primary button, the others are secondary.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".tab-btn")];
  tabs.forEach((btn) => {
    btn.addEventListener("click", () => {
      tabs.forEach((b) => {
        const on = b === btn;
        b.classList.toggle("btn-red", on);
        b.classList.toggle("btn-secondary", !on);
        b.setAttribute("aria-pressed", String(on));
        document.getElementById("tab-" + b.dataset.tab)?.classList.toggle("active", on);
      });
    });
  });

  // The text under a thumbnail plays the video too (the thumbnail itself is the facade link).
  document.querySelectorAll<HTMLElement>("[data-play-card]").forEach((body) => {
    body.addEventListener("click", () => {
      body.closest(".thumb-card")?.querySelector<HTMLAnchorElement>("[data-video-id]")?.click();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".carousel-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const track = document.getElementById("carousel-" + btn.dataset.carousel);
      if (!track) return;
      track.scrollLeft += (btn.classList.contains("prev") ? -1 : 1) * Math.round(track.clientWidth * 0.8);
    });
  });
</script>

</MainLayout>
