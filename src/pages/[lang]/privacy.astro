---
import MainLayout from "../../layouts/MainLayout.astro";
import {
  supportedLangs,
  siteContent,
  getLangFromParams,
  buildNav,
  buildFooter,
} from "../../data/site";

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromParams(Astro.params.lang);
const t = siteContent[lang];

const copy = {
  en: {
    title: "Privacy Policy",
    updated: `Last updated: ${new Date().getFullYear()}`,
    items: [
      ["Who runs this site", "Simon Beltran, a private individual, Sofia, Bulgaria. Contact:", "mailText"],
      ["What I collect", "Your email address, only if you sign up for the newsletter."],
      ["Why", "To send you the newsletter. Nothing else."],
      ["Legal basis", "Your consent, given when you tick the box."],
      ["Who handles it", "Resend, the service that sends the newsletter emails."],
      ["Outside the EU", "Resend and Vercel are US companies, so your data may be processed outside the European Union."],
      ["Your IP address", "Used briefly to stop abuse of the form, and kept for a short time in the host's logs."],
      ["How long", "Until you unsubscribe."],
      ["Unsubscribe, access or deletion", "Just send an email to", "mail"],
      ["Changed your mind?", "You can withdraw your consent at any time, with an email to the same address."],
      ["Complaints", "You can complain to the Bulgarian data protection authority,", { href: "https://cpdp.bg/", label: "КЗЛД / CPDP" }],
    ],
  },
  fr: {
    title: "Politique de confidentialité",
    updated: `Dernière mise à jour : ${new Date().getFullYear()}`,
    items: [
      ["Qui édite ce site", "Simon Beltran, particulier, Sofia, Bulgarie. Contact :", "mailText"],
      ["Ce que je collecte", "Votre adresse e-mail, uniquement si vous vous inscrivez à la newsletter."],
      ["Pourquoi", "Pour vous envoyer la newsletter. Rien d'autre."],
      ["Base légale", "Votre consentement, donné en cochant la case."],
      ["Qui la traite", "Resend, le service qui envoie les e-mails de la newsletter."],
      ["Hors de l'UE", "Resend et Vercel sont des entreprises américaines : vos données peuvent donc être traitées hors de l'Union européenne."],
      ["Votre adresse IP", "Utilisée brièvement pour empêcher les abus du formulaire, et conservée peu de temps dans les journaux de l'hébergeur."],
      ["Combien de temps", "Jusqu'à votre désinscription."],
      ["Désinscription, accès ou suppression", "Il suffit d'envoyer un e-mail à", "mail"],
      ["Vous avez changé d'avis ?", "Vous pouvez retirer votre consentement à tout moment, par un e-mail à la même adresse."],
      ["Réclamations", "Vous pouvez saisir l'autorité bulgare de protection des données,", { href: "https://cpdp.bg/", label: "КЗЛД / CPDP" }],
    ],
  },
  es: {
    title: "Política de privacidad",
    updated: `Última actualización: ${new Date().getFullYear()}`,
    items: [
      ["Quién edita este sitio", "Simon Beltran, particular, Sofía, Bulgaria. Contacto:", "mailText"],
      ["Qué recojo", "Tu dirección de correo electrónico, solo si te suscribes a la newsletter."],
      ["Por qué", "Para enviarte la newsletter. Nada más."],
      ["Base legal", "Tu consentimiento, dado al marcar la casilla."],
      ["Quién la gestiona", "Resend, el servicio que envía los correos de la newsletter."],
      ["Fuera de la UE", "Resend y Vercel son empresas estadounidenses, por lo que tus datos pueden tratarse fuera de la Unión Europea."],
      ["Tu dirección IP", "Se usa brevemente para impedir abusos del formulario y se conserva poco tiempo en los registros del alojamiento."],
      ["Cuánto tiempo", "Hasta que te des de baja."],
      ["Baja, acceso o supresión", "Basta con enviar un correo a", "mail"],
      ["¿Has cambiado de opinión?", "Puedes retirar tu consentimiento en cualquier momento, con un correo a la misma dirección."],
      ["Reclamaciones", "Puedes presentar una reclamación ante la autoridad búlgara de protección de datos,", { href: "https://cpdp.bg/", label: "КЗЛД / CPDP" }],
    ],
  },
  bg: {
    title: "Политика за поверителност",
    updated: `Последна актуализация: ${new Date().getFullYear()}`,
    items: [
      ["Кой поддържа сайта", "Симон Белтран, физическо лице, София, България. Контакт:", "mailText"],
      ["Какво събирам", "Вашия имейл адрес, само ако се абонирате за бюлетина."],
      ["Защо", "За да ви изпращам бюлетина. Нищо друго."],
      ["Правно основание", "Вашето съгласие, дадено с отбелязване на полето."],
      ["Кой го обработва", "Resend, услугата, която изпраща имейлите на бюлетина."],
      ["Извън ЕС", "Resend и Vercel са американски компании, затова данните ви може да се обработват извън Европейския съюз."],
      ["Вашият IP адрес", "Използва се за кратко, за да се предотвратят злоупотреби с формуляра, и се пази за кратко в дневниците на хостинга."],
      ["Колко дълго", "Докато не се отпишете."],
      ["Отписване, достъп или изтриване", "Просто изпратете имейл до", "mail"],
      ["Променихте решението си?", "Можете да оттеглите съгласието си по всяко време с имейл на същия адрес."],
      ["Жалби", "Можете да подадете жалба до българския орган за защита на данните,", { href: "https://cpdp.bg/", label: "КЗЛД / CPDP" }],
    ],
  },
}[lang] as { title: string; updated: string; items: [string, string, (string | { href: string; label: string })?][] };

const privacyMeta = {
  en: { title: "Privacy Policy | People's Republic of Bulgaria", description: "Privacy policy for the People's Republic of Bulgaria website." },
  fr: { title: "Politique de confidentialité | République Populaire de Bulgarie", description: "Politique de confidentialité du site People's Republic of Bulgaria." },
  es: { title: "Política de privacidad | República Popular de Bulgaria", description: "Política de privacidad del sitio web People's Republic of Bulgaria." },
  bg: { title: "Политика за поверителност | Народна република България", description: "Политика за поверителност на уебсайта People's Republic of Bulgaria." },
}[lang];
---

<MainLayout
  lang={lang}
  title={privacyMeta.title}
  description={privacyMeta.description}
  nav={buildNav(lang, t)}
  footer={buildFooter(lang, t)}
  active="legal"
  heroImage="/home/BackGroundHome.jpg"
>

<style>
.page-wrap {
  max-width: 800px;
  margin: 0 auto;
  padding: 30px 20px 60px;
}

.page-title {
  font-family: 'Oswald', sans-serif;
  font-size: 2.8rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #f0ebe0;
  border-bottom: 3px solid #D62612;
  padding-bottom: 10px;
  margin-bottom: 8px;
}

.page-updated {
  font-size: 1.2rem;
  color: #555;
  margin-bottom: 24px;
  font-style: italic;
}

.intro-box {
  background: #242424;
  border-left: 4px solid #D62612;
  padding: 14px 18px;
  margin-bottom: 28px;
  font-size: 1.35rem;
  color: #888;
  font-style: italic;
  line-height: 1.7;
}

.legal-block {
  margin-bottom: 30px;
}

.legal-block h2 {
  font-family: 'Oswald', sans-serif;
  font-size: 1.9rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #D62612;
  border-left: 4px solid #D62612;
  padding-left: 12px;
  margin-bottom: 12px;
}

.legal-block p {
  font-size: 1.45rem;
  color: #aaa;
  line-height: 1.85;
  margin-bottom: 8px;
}

.legal-block a {
  color: #D62612;
}

.legal-block a:hover {
  text-decoration: underline;
}

.authorities {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.authority-item {
  background: #242424;
  border: 1px solid #333;
  padding: 12px 18px;
  font-size: 1.35rem;
  color: #aaa;
  flex: 1;
  min-width: 200px;
}

.authority-item a {
  color: #D62612;
}
</style>

<div class="page-wrap">
  <h1 class="page-title">{copy.title}</h1>
  <p class="page-updated">{copy.updated}</p>

  {copy.items.map(([heading, text, extra]) => (
    <div class="legal-block">
      <h2>{heading}</h2>
      <p>
        {text}
        {extra === "mailText" && (<>{" "}<a href="mailto:contact@peoplesrepublicofbulgaria.com">contact@peoplesrepublicofbulgaria.com</a></>)}
        {extra === "mail" && (<>{" "}<a href="mailto:contact@peoplesrepublicofbulgaria.com">contact@peoplesrepublicofbulgaria.com</a>.</>)}
        {typeof extra === "object" && (<>{" "}<a href={extra.href === "privacy" ? `/${lang}/privacy` : extra.href} {...(extra.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>{extra.label}</a>.</>)}
      </p>
    </div>
  ))}
</div>

</MainLayout>
