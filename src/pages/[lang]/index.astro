---
import MainLayout from "../../layouts/MainLayout.astro";
import {
  supportedLangs,
  siteContent,
  getLangFromParams,
  buildNav,
  buildFooter,
} from "../../data/site";
import VideoFacade from "../../components/VideoFacade.astro";
import { getLatestVideo } from "../../lib/latest-video";
import { noIcon } from "../../lib/text";

// Rendered on the server so the latest video updates by itself (public channel feed, no API key).
export const prerender = false;

// Only the four site languages exist: anything else is a 404, not a copy of the English page.
if (!supportedLangs.includes(Astro.params.lang as (typeof supportedLangs)[number])) {
  return new Response(null, { status: 404 });
}

const lang = getLangFromParams(Astro.params.lang);
const t = siteContent[lang];

const latest = await getLatestVideo();
const latestVideo = latest ? { videoId: latest.id, title: latest.title, video: latest } : null;

// CDN keeps the page 30 min, then serves the old copy while refreshing it.
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=1800, stale-while-revalidate=86400");

// Explore cards: same 16:9 format, AVIF/WebP, lazy loaded (below the first screen).
const pic = (base: string, widths: number[]) => (ext: string) => widths.map((w) => `${base}-${w}.${ext} ${w}w`).join(", ");
const cards = [
  { page: "history", img: "/home/History", set: pic("/home/History", [640, 960]), ...t.home.cards.history },
  { page: "collection", img: "/home/Collection", set: pic("/home/Collection", [640]), ...t.home.cards.collection },
  { page: "tourism", img: "/home/Tourism", set: pic("/home/Tourism", [640]), ...t.home.cards.tourism },
  { page: "videos", img: "/home/background_videos", set: pic("/home/background_videos", [640, 960]), ...t.home.cards.videos },
];
---

<MainLayout
  lang={lang}
  title={t.home.title}
  description={t.home.description}
  nav={buildNav(lang, t)}
  footer={buildFooter(lang, t)}
  active="home"
  heroImage="/home/BackGroundHome.webp"
>

<style>
/* Home page. Spacing, colours and radii come from the tokens defined in MainLayout. */
.home-section { margin-top: var(--s-8); }
.home-section:first-child { margin-top: 0; }

.section-title {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  font-family: 'Oswald', sans-serif;
  font-size: clamp(2.2rem, 2.6vw, 2.8rem);
  line-height: 1.2;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent); /* large text: 3.5:1, AA for titles */
  margin-bottom: var(--s-5);
}

/* Welcome */
.welcome-box {
  max-width: 820px;
  padding-top: var(--s-2);
}
.welcome-box h2 {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(2.4rem, 3vw, 3.2rem);
  line-height: 1.15;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: var(--s-3);
}
.welcome-box p {
  max-width: 70ch;
  font-size: clamp(1.7rem, 1.6vw, 1.9rem);
  line-height: 1.7;
  color: var(--text-2);
}
.notice {
  margin-top: var(--s-4);
  padding-top: var(--s-4);
  border-top: 1px solid var(--line);
  font-size: 1.45rem !important;
  font-style: italic;
  color: var(--text-3) !important;
}

/* Explore: 4 cards, same image format */
.home-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--s-5);
}
.home-card {
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
}
.home-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); border-color: var(--line-strong); }
.home-card picture { display: block; overflow: hidden; }
.home-card img {
  width: 100%;
  aspect-ratio: 16 / 9;
  height: auto;
  object-fit: cover;
  transition: transform 0.6s var(--ease);
}
.home-card:hover img { transform: scale(1.04); }
.home-card-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: var(--s-5);
}
.home-card-body h3 {
  font-family: 'Oswald', sans-serif;
  font-size: 2.2rem;
  line-height: 1.2;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: var(--s-2);
}
.home-card-body p {
  font-size: 1.55rem;
  line-height: 1.6;
  color: var(--text-2);
  margin-bottom: var(--s-4);
}
.home-card-body .btn-secondary { margin-top: auto; align-self: flex-start; }
.home-card:hover .btn-secondary { border-color: var(--text-2); }

/* Latest video */
.video-wrap { }
.video-embed {
  position: relative;
  padding-bottom: 56.25%;
  background: #000;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}
.video-embed iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}
.video-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-3);
  margin-top: var(--s-4);
}
.no-video { color: var(--text-2); }

/* Newsletter */
.newsletter-box {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: clamp(2.4rem, 4vw, 4rem);
}
.newsletter-text {
  max-width: 62ch;
  font-size: 1.6rem;
  line-height: 1.7;
  color: var(--text-2);
  margin-bottom: var(--s-5);
}
.newsletter-form {
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
  align-items: flex-start;
  max-width: 560px;
}
.newsletter-form input[type="email"] {
  width: 100%;
  min-height: 48px;
  background: var(--bg);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-family: 'Roboto', sans-serif;
  font-size: 1.6rem;
  padding: 1rem 1.4rem;
  transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
}
.newsletter-form input[type="email"]::placeholder { color: var(--text-3); }
.newsletter-form input[type="email"]:focus { border-color: var(--text-2); }
.newsletter-consent {
  display: flex;
  align-items: flex-start;
  gap: var(--s-3);
  font-size: 1.45rem;
  line-height: 1.6;
  color: var(--text-2);
  margin-bottom: var(--s-2);
}
.newsletter-consent input {
  width: 20px;
  height: 20px;
  margin-top: 2px;
  flex: 0 0 auto;
  accent-color: var(--accent);
}
@media (min-width: 900px) {
  .newsletter-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    column-gap: var(--s-7);
    align-items: start;
  }
  .newsletter-box .section-title, .newsletter-box .newsletter-text { grid-column: 1; }
  .newsletter-box .newsletter-form { grid-column: 2; grid-row: 1 / span 2; }
  .newsletter-box .form-feedback { grid-column: 2; }
  .newsletter-box .form-feedback { grid-row: 3; }
  .newsletter-form { max-width: none; }
}
.form-feedback { margin-top: var(--s-4); font-size: 1.5rem; line-height: 1.6; color: var(--text-2); }
.form-feedback:empty { display: none; }
.form-feedback.success { color: #9ad3a5; }
.form-feedback.error { color: var(--accent-text); }

/* Socials */
.socials-box { text-align: center; }
.socials-box .section-title { justify-content: center; margin-bottom: var(--s-2); }
.socials-text {
  max-width: 60ch;
  margin: 0 auto var(--s-5);
  font-size: 1.6rem;
  color: var(--text-2);
}
.socials-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--s-4);
}
.social-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-5) var(--s-3);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
}
.social-card:hover { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: var(--shadow); }
.social-card img { width: 32px; height: 32px; object-fit: contain; }
.social-card strong {
  font-family: 'Oswald', sans-serif;
  font-size: 1.6rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.social-card span {
  max-width: 100%;
  font-size: 1.3rem;
  color: var(--text-3);
  overflow-wrap: anywhere;
}

@media (max-width: 760px) {
  .home-grid { grid-template-columns: 1fr; }
  .socials-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 480px) {
  .socials-grid { grid-template-columns: 1fr; gap: var(--s-3); }
  .social-card { flex-direction: row; justify-content: flex-start; text-align: left; padding: var(--s-4); gap: var(--s-4); }
  .social-card strong { min-width: 9rem; }
  .social-card span { overflow-wrap: normal; word-break: normal; }
}
@media (max-width: 560px) {
  .newsletter-form .btn-red { width: 100%; }
  .video-actions > * { flex: 1 1 auto; }
}
</style>

<section class="home-section welcome-box reveal">
  <h2>{t.home.welcomeTitle}</h2>
  <p>{t.home.welcomeText}</p>
  <p class="notice">{t.home.notice}</p>
</section>

<section class="home-section" aria-labelledby="explore-title">
  <h2 class="section-title" id="explore-title">{noIcon(t.home.explore)}</h2>
  <div class="home-grid">
    {cards.map((card) => (
      <a href={`/${lang}/${card.page}`} class="home-card reveal">
        <picture>
          <source type="image/avif" srcset={card.set("avif")} sizes="(min-width: 761px) 560px, 100vw" />
          <img src={`${card.img}-640.webp`} srcset={card.set("webp")} sizes="(min-width: 761px) 560px, 100vw" width="640" height="360" alt={card.title} loading="lazy" decoding="async" />
        </picture>
        <div class="home-card-body">
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
          <span class="btn-secondary">
            {card.btn}
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<section class="home-section video-wrap reveal" aria-labelledby="video-title">
  <h2 class="section-title" id="video-title">{noIcon(t.home.latestVideo)}</h2>

  {latestVideo ? (
    <>
      <div class="video-embed">
        <VideoFacade video={latestVideo.video} playLabel={{ en: "Play", fr: "Lecture", es: "Reproducir", bg: "Пусни" }[lang]} />
      </div>

      <div class="video-actions">
        <a class="btn-red" href={`https://www.youtube.com/watch?v=${latestVideo.videoId}`} target="_blank" rel="noopener noreferrer">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
          {noIcon(t.home.watchOnYoutube)}
        </a>
        <a class="btn-secondary" href={`/${lang}/videos`}>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg>
          {noIcon(t.home.allVideos)}
        </a>
      </div>
    </>
  ) : (
    <p class="no-video">{t.home.noVideo}</p>
  )}
</section>

<section class="home-section newsletter-box reveal" id="newsletter" aria-labelledby="newsletter-title">
  <h2 class="section-title" id="newsletter-title">{t.home.newsletter.title}</h2>
  <p class="newsletter-text">{t.home.newsletter.text}</p>

  <form id="newsletter-form" action="/api/newsletter" method="POST" class="newsletter-form"
    data-subscribing={t.home.newsletter.subscribing}
    data-success={noIcon(t.home.newsletter.success)}
    data-success-hint={t.home.newsletter.successHint}
    data-error={noIcon(t.home.newsletter.error)}
    data-error-network={noIcon(t.home.newsletter.errorNetwork)}
    data-error-rate-limit={noIcon(t.home.newsletter.errorRateLimit)}
  >
    <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <label class="sr-only" for="newsletter-email">{t.home.newsletter.placeholder}</label>
    <input type="email" name="email" id="newsletter-email" placeholder={t.home.newsletter.placeholder} required />
    <label class="newsletter-consent">
      <input type="checkbox" id="newsletter-consent" name="consent" required />
      {t.home.newsletter.consent}
    </label>
    <button type="submit" class="btn-red">{t.home.newsletter.button}</button>
  </form>
  <div id="newsletter-feedback" class="form-feedback" role="status" aria-live="polite"></div>
</section>

<section class="home-section socials-box reveal" aria-labelledby="socials-title">
  <h2 class="section-title" id="socials-title">{t.home.socials.title}</h2>
  <p class="socials-text">{t.home.socials.text}</p>

  <div class="socials-grid">
    <a href="https://www.instagram.com/peoplesrepublicofbulgaria/" target="_blank" rel="noopener noreferrer" class="social-card">
      <img src="/png/icons/instagram-64.webp" alt="Instagram" width="32" height="32" loading="lazy" />
      <strong>Instagram</strong>
      <span>@peoplesrepublicofbulgaria</span>
    </a>

    <a href="https://www.youtube.com/@PeoplesRepublicOfBulgaria1505" target="_blank" rel="noopener noreferrer" class="social-card">
      <img src="/png/icons/youtube-64.webp" alt="YouTube" width="32" height="32" loading="lazy" />
      <strong>YouTube</strong>
      <span>@PeoplesRepublicOfBulgaria</span>
    </a>

    <a href="https://www.facebook.com/PeoplesRepublicOfBulgaria/" target="_blank" rel="noopener noreferrer" class="social-card">
      <img src="/png/icons/facebook-64.webp" alt="Facebook" width="32" height="32" loading="lazy" />
      <strong>Facebook</strong>
      <span>People's Republic Of Bulgaria</span>
    </a>

    <a href="https://www.tiktok.com/@peoplesrepublicof70" target="_blank" rel="noopener noreferrer" class="social-card">
      <img src="/png/icons/tiktok-64.webp" alt="TikTok" width="32" height="32" loading="lazy" />
      <strong>TikTok</strong>
      <span>@peoplesrepublicof70</span>
    </a>
  </div>
</section>

<script>
  const newsletterForm = document.getElementById("newsletter-form");
  const newsletterFeedback = document.getElementById("newsletter-feedback");
  const newsletterLoadedAt = performance.now();

  newsletterForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const msgs = {
      subscribing: newsletterForm.dataset.subscribing,
      success: newsletterForm.dataset.success,
      successHint: newsletterForm.dataset.successHint,
      error: newsletterForm.dataset.error,
      errorNetwork: newsletterForm.dataset.errorNetwork,
      errorRateLimit: newsletterForm.dataset.errorRateLimit,
    };

    newsletterFeedback.textContent = msgs.subscribing;
    newsletterFeedback.className = "form-feedback";

    const formData = new FormData(newsletterForm);
    formData.set("elapsed_ms", String(Math.round(performance.now() - newsletterLoadedAt)));

    try {
      const res = await fetch("/api/newsletter", {
        method: "POST",
        body: formData,
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        newsletterFeedback.innerHTML = `
          ${msgs.success}<br>
          <span style="font-size:1.3rem;color:#888;">${msgs.successHint}</span>
        `;
        newsletterFeedback.className = "form-feedback success";
        newsletterForm.reset();
      } else if (res.status === 429) {
        newsletterFeedback.textContent = msgs.errorRateLimit;
        newsletterFeedback.className = "form-feedback error";
      } else if (res.status >= 500) {
        newsletterFeedback.textContent = msgs.error;
        newsletterFeedback.className = "form-feedback error";
      } else {
        newsletterFeedback.textContent = data.error || msgs.error;
        newsletterFeedback.className = "form-feedback error";
      }
    } catch {
      newsletterFeedback.textContent = msgs.errorNetwork;
      newsletterFeedback.className = "form-feedback error";
    }
  });
</script>
</MainLayout>