---
import MainLayout from "../../layouts/MainLayout.astro";
import {
  supportedLangs,
  siteContent,
  getLangFromParams,
  buildNav,
  buildFooter,
} from "../../data/site";

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromParams(Astro.params.lang);
const t = siteContent[lang];

const copy = {
  en: {
    title: "Legal Notice",
    updated: `Last updated: ${new Date().getFullYear()}`,
    items: [
      ["Who runs this site", "Simon Beltran, a private individual, Sofia, Bulgaria. Contact:", "mailText"],
      ["Hosting", "Vercel."],
      ["Cookies and tracking", "No tracking tools on this site. On the home page, the video only loads after you click it; the Videos page embeds YouTube, which may set its own cookies."],
      ["Privacy", "How your email address is handled for the newsletter:", { href: "privacy", label: "Privacy Policy" }],
    ],
  },
  fr: {
    title: "Mentions légales",
    updated: `Dernière mise à jour : ${new Date().getFullYear()}`,
    items: [
      ["Qui édite ce site", "Simon Beltran, particulier, Sofia, Bulgarie. Contact :", "mailText"],
      ["Hébergement", "Vercel."],
      ["Cookies et suivi", "Aucun outil de suivi sur ce site. Sur la page d'accueil, la vidéo ne se charge qu'après un clic ; la page Vidéos intègre YouTube, qui peut déposer ses propres cookies."],
      ["Confidentialité", "Comment votre adresse e-mail est traitée pour la newsletter :", { href: "privacy", label: "Politique de confidentialité" }],
    ],
  },
  es: {
    title: "Aviso legal",
    updated: `Última actualización: ${new Date().getFullYear()}`,
    items: [
      ["Quién edita este sitio", "Simon Beltran, particular, Sofía, Bulgaria. Contacto:", "mailText"],
      ["Alojamiento", "Vercel."],
      ["Cookies y seguimiento", "Ninguna herramienta de seguimiento en este sitio. En la página de inicio, el vídeo solo se carga después de hacer clic; la página Vídeos integra YouTube, que puede instalar sus propias cookies."],
      ["Privacidad", "Cómo se trata tu dirección de correo para la newsletter:", { href: "privacy", label: "Política de privacidad" }],
    ],
  },
  bg: {
    title: "Правна информация",
    updated: `Последна актуализация: ${new Date().getFullYear()}`,
    items: [
      ["Кой поддържа сайта", "Симон Белтран, физическо лице, София, България. Контакт:", "mailText"],
      ["Хостинг", "Vercel."],
      ["Бисквитки и проследяване", "На този сайт няма инструменти за проследяване. На началната страница видеото се зарежда едва след като кликнете върху него; страницата „Видеа“ вгражда YouTube, който може да постави свои бисквитки."],
      ["Поверителност", "Как се обработва имейл адресът ви за бюлетина:", { href: "privacy", label: "Политика за поверителност" }],
    ],
  },
}[lang] as { title: string; updated: string; items: [string, string, (string | { href: string; label: string })?][] };
---

<MainLayout
  lang={lang}
  title={t.legal.title}
  description={t.legal.description}
  nav={buildNav(lang, t)}
  footer={buildFooter(lang, t)}
  active="legal"
  heroImage="/home/BackGroundHome.jpg"
>

<style>
.page-wrap {
  max-width: 800px;
  margin: 0 auto;
  padding: 30px 20px 60px;
}

.page-title {
  font-family: 'Oswald', sans-serif;
  font-size: 2.8rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #f0ebe0;
  border-bottom: 3px solid #D62612;
  padding-bottom: 10px;
  margin-bottom: 8px;
}

.page-updated {
  font-size: 1.2rem;
  color: #555;
  margin-bottom: 24px;
  font-style: italic;
}

.legal-block {
  margin-bottom: 30px;
}

.legal-block h2 {
  font-family: 'Oswald', sans-serif;
  font-size: 1.9rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #D62612;
  border-left: 4px solid #D62612;
  padding-left: 12px;
  margin-bottom: 12px;
}

.legal-block p {
  font-size: 1.45rem;
  color: #aaa;
  line-height: 1.85;
  margin-bottom: 8px;
}

.legal-block a {
  color: #D62612;
}

.legal-block a:hover {
  text-decoration: underline;
}

.notice-box {
  background: #242424;
  border-left: 4px solid #D62612;
  padding: 14px 18px;
  margin-bottom: 28px;
  font-size: 1.35rem;
  color: #888;
  font-style: italic;
  line-height: 1.7;
}

.company-box {
  background: #242424;
  border: 1px solid #333;
  padding: 14px 18px;
  margin: 8px 0;
  font-size: 1.4rem;
  color: #ccc;
  line-height: 1.7;
}
</style>

<div class="page-wrap">
  <h1 class="page-title">{copy.title}</h1>
  <p class="page-updated">{copy.updated}</p>

  {copy.items.map(([heading, text, extra]) => (
    <div class="legal-block">
      <h2>{heading}</h2>
      <p>
        {text}
        {extra === "mailText" && (<>{" "}<a href="mailto:contact@peoplesrepublicofbulgaria.com">contact@peoplesrepublicofbulgaria.com</a></>)}
        {extra === "mail" && (<>{" "}<a href="mailto:contact@peoplesrepublicofbulgaria.com">contact@peoplesrepublicofbulgaria.com</a>.</>)}
        {typeof extra === "object" && (<>{" "}<a href={extra.href === "privacy" ? `/${lang}/privacy` : extra.href} {...(extra.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>{extra.label}</a>.</>)}
      </p>
    </div>
  ))}
</div>

</MainLayout>