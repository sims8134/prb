---
import MainLayout from "../../layouts/MainLayout.astro";
import PhotoGallery from "../../components/PhotoGallery.astro";
import { noIcon } from "../../lib/text";
import "../../styles/content.css";
import {
  supportedLangs,
  siteContent,
  getLangFromParams,
  buildNav,
  buildFooter,
} from "../../data/site";

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromParams(Astro.params.lang);
const t = siteContent[lang];

const images = [
  "/tourism/diapo/20211106_135546.jpg",
  "/tourism/diapo/20211106_140338.jpg",
  "/tourism/diapo/20211106_141153.jpg",
  "/tourism/diapo/20220430_190649.jpg",
  "/tourism/diapo/20220501_165608.jpg",
  "/tourism/diapo/20220529_142138.jpg",
  "/tourism/diapo/20220813_140057.jpg",
  "/tourism/diapo/20230430_115759.jpg",
  "/tourism/diapo/20230506_112944.jpg",
  "/tourism/diapo/20230617_131501.jpg",
  "/tourism/diapo/20230820_144845.jpg",
  "/tourism/diapo/IMG_6325 (2).JPG",
];

const copy = {
  en: {
    title: "Tourism",
    subtitle: "Voyage, voyage...",
    contactText:
      "🗺️ If you wish to plan a private visit or if you need a guide, feel free to contact me:",
    gallery: "Photo Gallery",
    bottom1: "Planning a visit to Bulgaria? Need a private guide?",
  },
  fr: {
    title: "Tourisme",
    subtitle: "Voyage, voyage...",
    contactText:
      "🗺️ Si vous souhaitez organiser une visite privée ou si vous avez besoin d’un guide, n’hésitez pas à me contacter :",
    gallery: "Galerie photo",
    bottom1: "Vous préparez une visite en Bulgarie ? Besoin d’un guide privé ?",
  },
  es: {
    title: "Turismo",
    subtitle: "Voyage, voyage...",
    contactText:
      "🗺️ Si deseas organizar una visita privada o si necesitas un guía, no dudes en contactarme:",
    gallery: "Galería de fotos",
    bottom1: "¿Planeas una visita a Bulgaria? ¿Necesitas un guía privado?",
  },
  bg: {
    title: "Туризъм",
    subtitle: "Voyage, voyage...",
    contactText:
      "🗺️ Ако желаете да организирате частно посещение или имате нужда от гид, не се колебайте да се свържете с мен:",
    gallery: "Фотогалерия",
    bottom1: "Планирате посещение в България? Нуждаете се от частен гид?",
  },
}[lang];
---

<MainLayout
  lang={lang}
  title={t.tourism.title}
  description={t.tourism.description}
  nav={buildNav(lang, t)}
  footer={buildFooter(lang, t)}
  active="tourism"
  heroImage="/home/BackGroundHome.jpg"
>

<style>
/* Shared rules: src/styles/content.css. Only the two contact blocks are specific to this page. */
.contact-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--s-3) var(--s-5);
  max-width: 820px;
  padding: var(--s-5);
  margin-bottom: var(--s-7);
}
.contact-box p {
  flex: 1 1 32ch;
  font-size: 1.6rem;
  line-height: 1.6;
  color: var(--text-2);
}
.contact-box .plain-link,
.bottom-contact .plain-link {
  font-family: 'Oswald', sans-serif;
  font-size: 1.7rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.bottom-contact {
  margin-top: var(--s-7);
  padding: var(--s-6) var(--s-5);
  text-align: center;
}
.bottom-contact p {
  font-size: 1.6rem;
  line-height: 1.6;
  color: var(--text-2);
  margin-bottom: var(--s-2);
}
</style>

<div class="page-wrap">
  <h1 class="page-title">{copy.title}</h1>
  <p class="page-subtitle">{copy.subtitle}</p>

  <div class="contact-box content-card">
    <span class="content-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6 9 4z" /><path d="M9 4v14M15 6v6" /></svg></span>
    <p>{noIcon(copy.contactText)}</p>
    <a href="mailto:contact@peoplesrepublicofbulgaria.com" class="plain-link">
      contact@peoplesrepublicofbulgaria.com
    </a>
  </div>

  <p class="section-label">{copy.gallery}</p>

  <PhotoGallery images={images} altPrefix="Tourism" lang={lang} />
</div>

<div class="bottom-contact content-card">
  <p>{copy.bottom1}</p>
  <a href="mailto:contact@peoplesrepublicofbulgaria.com" class="plain-link">
    contact@peoplesrepublicofbulgaria.com
  </a>
</div>

</MainLayout>
