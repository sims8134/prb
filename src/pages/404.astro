---
// Not found page, in the visitor's language when the URL starts with one (/fr/..., /es/..., /bg/...).
// Under the message: a way back home, then the two "What next" cards (added by MainLayout, compact).
import MainLayout from "../layouts/MainLayout.astro";
import { supportedLangs, siteContent, buildNav, buildFooter, type Lang } from "../data/site";

export const prerender = false;

const first = Astro.url.pathname.split("/").filter(Boolean)[0] as Lang;
const lang: Lang = supportedLangs.includes(first) ? first : "en";
const t = siteContent[lang];
Astro.response.status = 404;

const copy = {
  en: { title: "Page not found", text: "This page does not exist or has moved.", back: "Back to the home page" },
  fr: { title: "Page introuvable", text: "Cette page n'existe pas ou a été déplacée.", back: "Retour à l'accueil" },
  es: { title: "Página no encontrada", text: "Esta página no existe o se ha movido.", back: "Volver a la página de inicio" },
  bg: { title: "Страницата не е намерена", text: "Тази страница не съществува или е преместена.", back: "Обратно към началната страница" },
}[lang];
---

<MainLayout
  lang={lang}
  title={`${copy.title} | People's Republic of Bulgaria`}
  description={copy.text}
  nav={buildNav(lang, t)}
  footer={buildFooter(lang, t)}
  pageName="404"
>
  <style>
    .not-found { max-width: 820px; }
    .not-found h2 {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(2.4rem, 3vw, 3.2rem);
      line-height: 1.15;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--accent);
      margin-bottom: var(--s-3);
    }
    .not-found p { font-size: 1.7rem; line-height: 1.7; color: var(--text-2); margin-bottom: var(--s-5); }
  </style>

  <section class="not-found">
    <h2>{copy.title}</h2>
    <p>{copy.text}</p>
    <a class="btn-secondary" href={`/${lang}`}>
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      {copy.back}
    </a>
  </section>
</MainLayout>
