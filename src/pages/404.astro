---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | People's Republic of Bulgaria" description="This page is not here any more." path="/404" noindex>
  <main class="lost">
    <img class="lost__seal" src="/brand/logo-160.webp" srcset="/brand/logo-160.webp 160w, /brand/logo-320.webp 320w" sizes="104px" width="104" height="104" alt="PRB logo" />
    <p class="label">№ 404</p>
    <h1>This page is not here any more</h1>
    <p class="lost__text">The site now fits on a single page. The latest video is waiting for you there.</p>
    <a class="cta" href="/">Go to the latest video</a>
  </main>
</Base>

<style>
  .lost {
    width: 100%;
    padding: 3rem var(--gutter) 4rem;
  }
  .lost__seal {
    display: block;
    margin-bottom: 1.5rem;
    rotate: -8deg;
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.6));
  }
  .label {
    margin: 0 0 0.5rem;
  }
  h1 {
    margin: 0 0 1rem;
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 11vw, 7.5rem);
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--cream);
  }
  .lost__text {
    margin: 0 0 1.75rem;
    max-width: 32rem;
    color: var(--muted);
  }
</style>
