---
// PROTOTYPE B: "Contact sheet". Temporary, not linked, not indexed.
import Base from "../../layouts/Base.astro";
import VideoFacade from "../../components/VideoFacade.astro";
import { CHANNEL_URL, getLatestVideo, romanDate, spokenDate } from "../../lib/latest-video";

export const prerender = false;
const video = await getLatestVideo();
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=1800, stale-while-revalidate=86400");

// Frames 02 to 06: my own photos (Samsung phone, dates from the EXIF).
const frames = [
  { slug: "blocks", date: "20 VIII 2023", alt: "Two tall panel-block towers joined by a bridge of flats, against a blue sky" },
  { slug: "missiles", date: "6 XI 2021", alt: "A twin missile launcher on a tracked vehicle, seen from the front" },
  { slug: "mosaic", date: "30 IV 2023", alt: "A large round mosaic of a figure holding a wheel, set in a stone wall" },
  { slug: "shumen", date: "13 VIII 2022", alt: "Giant angular concrete figures of a hilltop monument" },
  { slug: "relief", date: "17 VI 2023", alt: "A long carved stone relief at the foot of a high-rise building" },
];
const set = (slug: string, ext: string) =>
  (slug === "blocks" || slug === "missiles" ? [640, 1080] : [480, 800]).map((w) => `/photos/${slug}-${w}.${ext} ${w}w`).join(", ");
---

<Base title="Prototype B | People's Republic of Bulgaria" description="Prototype B" path="/proto/b" noindex>
  <main class="sheet">
    <header class="top">
      <img class="top__logo" src="/brand/logo-160.webp" srcset="/brand/logo-160.webp 160w, /brand/logo-320.webp 320w" sizes="72px" width="72" height="72" alt="PRB logo" />
      <h1 class="top__name">People's Republic of Bulgaria</h1>
      <p class="top__line">Archive mixes and urbex from Bulgaria's Cold War years, on YouTube.</p>
    </header>

    <section class="strip" aria-label="Contact sheet: the latest video and photos from the ground">
      <ol class="strip__frames">
        <li class="frame frame--pick">
          <a href="#latest" class="frame__link">
            {video?.thumbnail ? <img data-copy-thumb width="480" height="360" alt="" /> : <span class="frame__empty" />}
            <span class="sr-only">Frame 01: the latest video, {video?.title}</span>
          </a>
          <svg class="frame__circle" viewBox="0 0 200 150" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" d="M18 78 C 14 30, 70 10, 112 12 C 168 14, 192 46, 186 84 C 180 126, 120 142, 78 138 C 34 134, 8 110, 22 70" />
          </svg>
          <span class="frame__edge"><b>№ 01</b> {video ? romanDate(video.published) : ""}</span>
        </li>
        {
          frames.map((f, i) => (
            <li class="frame">
              <picture>
                <source type="image/avif" srcset={set(f.slug, "avif")} sizes="(min-width: 900px) 17vw, 46vw" />
                <img src={`/photos/${f.slug}-${f.slug === "blocks" || f.slug === "missiles" ? 640 : 480}.webp`} srcset={set(f.slug, "webp")} sizes="(min-width: 900px) 17vw, 46vw" width="480" height="360" alt={f.alt} loading={i < 1 ? "eager" : "lazy"} decoding="async" />
              </picture>
              <span class="frame__edge"><b>№ 0{i + 2}</b> {f.date}</span>
            </li>
          ))
        }
      </ol>
      <p class="strip__note">Frame № 01 is the latest video. The others: places I stood in, camera in hand.</p>
    </section>

    <section class="print" id="latest" aria-labelledby="latest-title">
      <h2 class="print__head" id="latest-title"><span class="label" aria-hidden="true">№ 01</span> Latest video</h2>
      <div class="print__grid">
        <div class="print__photo"><VideoFacade video={video} /></div>
        <div class="print__meta">
          {video && <p class="print__title">{video.title}</p>}
          {
            video && (
              <p class="print__date">
                <time datetime={video.published.toISOString()}>
                  <span aria-hidden="true">{romanDate(video.published)}</span>
                  <span class="sr-only">{spokenDate(video.published)}</span>
                </time>
                <span aria-hidden="true"> · </span>Grab a coffee, press play.
              </p>
            )
          }
          <a class="cta" href={`${CHANNEL_URL}?sub_confirmation=1`}>Subscribe on YouTube</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  :global(body) {
    background: #f6ead2;
  }
  .sheet {
    --vf-frame: #151312;
    --vf-ink: #f6ead2;
    --film: #151312;
    --grease: #d6402a; /* grease pencil red, 4.2:1 on the film black, used for the circle only */
  }

  .top {
    padding: 1.25rem 1.1rem 1.5rem;
  }
  .top__logo {
    display: block;
    width: 72px;
    height: 72px;
    margin-bottom: 0.75rem;
  }
  .top__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 12.5vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--bordeaux);
  }
  .top__line {
    margin: 0.9rem 0 0;
    max-width: 32rem;
    font-size: clamp(1.15rem, 4.4vw, 1.6rem);
    line-height: 1.35;
  }

  /* The contact sheet: a black band of numbered frames */
  .strip {
    background: var(--film);
    color: #f6ead2;
    padding: 1rem 0 1.1rem;
  }
  .strip__frames {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 46%;
    gap: 0.7rem;
    margin: 0;
    padding: 0.35rem 1.1rem 0.3rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .frame {
    position: relative;
    scroll-snap-align: start;
  }
  .frame img,
  .frame__empty {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: #2b2826;
  }
  .frame__link {
    display: block;
    overflow: hidden;
  }
  /* YouTube's hqdefault has black bars: zoom past them */
  .frame--pick img {
    scale: 1.34;
  }
  .frame__link:focus-visible {
    outline: 3px solid #f6ead2;
    outline-offset: 3px;
  }
  .frame__edge {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e9c98d; /* 11:1 on the film black */
  }
  .frame__edge b {
    color: #f6ead2;
    margin-right: 0.35rem;
  }
  .frame__circle {
    position: absolute;
    inset: -9% -7% auto -7%;
    width: 114%;
    aspect-ratio: 3 / 2;
    pointer-events: none;
    overflow: visible;
  }
  .frame__circle path {
    fill: none;
    stroke: var(--grease);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1.1s 0.5s cubic-bezier(0.6, 0.05, 0.3, 1) both;
  }
  .frame img {
    transition: transform 0.4s ease, filter 0.4s ease;
  }
  .frame:hover img {
    transform: scale(1.025);
  }
  .strip__note {
    margin: 0.75rem 1.1rem 0;
    font-size: 1rem;
    color: #f6ead2;
  }

  /* The print: the latest video, blown up */
  .print {
    padding: 2.25rem 1.1rem 3.5rem;
  }
  .print__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 8vw, 4.2rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--bordeaux);
  }
  .print__head .label {
    font-size: 0.4em;
  }
  .print__photo {
    background: #fffaf0;
    padding: 10px 10px 34px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08), 0 14px 30px -12px rgba(43, 26, 18, 0.45);
    rotate: -0.6deg;
  }
  .print__grid {
    display: grid;
    gap: 1.5rem;
  }
  .print__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.25;
  }
  .print__date {
    margin: 0;
    color: var(--gold-text);
  }
  .print__date time {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    margin-top: 1.25rem;
    padding: 0 1.75rem;
    background: var(--bordeaux);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .cta:hover {
    background: #3f0907;
  }
  .cta:focus-visible {
    outline-color: var(--ink);
  }

  @media (min-width: 900px) {
    .top {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 2rem;
      align-items: end;
      padding: 2.5rem clamp(2rem, 4vw, 5rem) 2.5rem;
    }
    .top__logo {
      width: 120px;
      height: 120px;
      grid-row: span 2;
      align-self: start;
      margin: 0.6rem 0 0;
    }
    .strip__frames {
      grid-auto-flow: row;
      grid-template-columns: repeat(6, 1fr);
      overflow: visible;
      padding: 0.6rem clamp(2rem, 4vw, 5rem) 0.3rem;
      gap: 1rem;
    }
    .strip__note {
      margin: 0.9rem clamp(2rem, 4vw, 5rem) 0;
    }
    .print {
      padding: 4.5rem clamp(2rem, 4vw, 5rem) 6rem;
    }
    .print__grid {
      grid-template-columns: 3fr 2fr;
      align-items: end;
      gap: 3.5rem;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>

<script>
  // Frame 01 reuses the thumbnail already embedded in the player, instead of embedding it twice.
  const source = document.querySelector<HTMLImageElement>("[data-video-id] img");
  document.querySelectorAll<HTMLImageElement>("img[data-copy-thumb]").forEach((img) => {
    if (source) img.src = source.src;
  });
</script>
