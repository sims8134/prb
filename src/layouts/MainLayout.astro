---
import { siteContent, supportedLangs, type Lang } from "../data/site";
import { nextSteps, coldWarBulgariaUrl, BUY_ME_A_COFFEE_URL } from "../data/next-steps";
import NextSteps from "../components/NextSteps.astro";
import "../styles/fonts.css"; // Oswald + Roboto hosted on this site (same rules as Google Fonts)
import "../styles/base.css"; // tokens, reset, focus, buttons (shared with the newsletter confirmation page)

const {
  lang = "en",
  title = "People's Republic of Bulgaria",
  description = "Cultural and historical archive",
  nav = [],
  footer = { links: [], copyright: "" },
  active = "",
  heroImage = "",
  pageName = "", // page of origin for outgoing links (defaults to the path, "home" for the home page)
} = Astro.props;

const t = siteContent[lang as keyof typeof siteContent] ?? siteContent["en"];
const ns = nextSteps[lang as Lang] ?? nextSteps.en;
// Exit points before the footer on the inner content pages. The home page places them
// itself (after the video); the legal and privacy pages (active="legal") have none, and
// neither does the about page, whose own content already has both exits.
// Copyright line: "{year}" in the text is replaced by the year (also refreshed in the browser).
const year = new Date().getFullYear();
const [copyrightBefore, copyrightAfter = ""] = String(footer.copyright).split("{year}");
const showNextSteps =!["home", "legal", "about"].includes(active);

// Chemin de la page SANS le préfixe de langue (ex: "/history", ou "" pour l'accueil)
const SITE = "https://peoplesrepublicofbulgaria.com";
const pathParts = Astro.url.pathname.replace(/\/$/, "").split("/").filter(Boolean);
// pathParts[0] est la langue (en/fr/es/bg) ; le reste est le chemin
const pagePath = pathParts.slice(1).join("/");
const subPath = pagePath ? `/${pagePath}` : "";
const page = pageName || pagePath || "home";

const heroStyle = heroImage
  ? `background-image: url('${heroImage}'); background-position: center 30%; background-size: cover; background-repeat: no-repeat;`
  : "";
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="People's Republic of Bulgaria" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#D62612" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://peoplesrepublicofbulgaria.com/brand/og-1200x630.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={`${SITE}/${lang}${subPath}`} />
  <meta property="og:site_name" content="People's Republic of Bulgaria" />
  <meta property="og:locale" content={lang === "fr" ? "fr_FR" : lang === "es" ? "es_ES" : lang === "bg" ? "bg_BG" : "en_US"} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://peoplesrepublicofbulgaria.com/brand/og-1200x630.jpg" />

 <!-- Hreflang -->
  {supportedLangs.map((l) => (
    <link rel="alternate" hreflang={l} href={`${SITE}/${l}${subPath}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${SITE}/en${subPath}`} />

<!-- Canonical -->
  <link rel="canonical" href={`${SITE}/${lang}${subPath}`} />

  <!-- Fonts: hosted on this site, see src/styles/fonts.css -->

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/brand/favicon-32.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "People's Republic of Bulgaria",
    "url": "https://peoplesrepublicofbulgaria.com",
    "description": "The first multilingual website dedicated to the history of the People's Republic of Bulgaria (1944–1990).",
    "inLanguage": ["en", "fr", "es", "bg"],
    "author": {
      "@type": "Organization",
      "name": "People's Republic of Bulgaria"
    },
    "sameAs": [
      "https://www.instagram.com/peoplesrepublicofbulgaria/",
      "https://www.youtube.com/@PeoplesRepublicOfBulgaria1505",
      "https://www.facebook.com/PeoplesRepublicOfBulgaria/",
      "https://www.tiktok.com/@peoplesrepublicof70"
    ]
  })} />

  <style is:global>

  html { scroll-behavior: smooth; scroll-padding-top: calc(var(--topbar-h) + 1.6rem); }
  body {
    font-family: 'Roboto', sans-serif;
    font-size: 1.6rem;
    line-height: 1.6;
    background: var(--bg);
    color: var(--text);
    overflow-x: clip; /* nothing may widen the page on phones */
  }
  ul { list-style: none; }
  img { display: block; max-width: 100%; }


  /* ---------- Fixed top bar ---------- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(17, 18, 20, 0.86);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  /* Reading progress: the red line under the bar fills from left to right with the scroll.
     Scroll-driven animation where supported (compositor only: no jank, no layout change);
     elsewhere a few lines of script set --progress (see the script at the end). */
  .topbar::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 3px;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
    will-change: transform;
  }
  @supports (animation-timeline: scroll()) {
    .topbar::after {
      animation: read-progress linear both;
      animation-timeline: scroll(root block);
    }
  }
  @keyframes read-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .topbar-inner {
    max-width: var(--max);
    margin: 0 auto;
    height: var(--topbar-h);
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
    margin-right: auto;
  }
  .brand img { width: 40px; height: 40px; }
  .brand > span {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 1.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .main-nav ul { display: flex; align-items: center; gap: var(--s-1); }
  .main-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.2rem;
    border-radius: var(--radius-sm);
    font-family: 'Oswald', sans-serif;
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  /* hover and keyboard focus: a red outline, like the flag of the active language */
  .main-nav a { transition: color 0.2s var(--ease), background-color 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .main-nav a:hover, .main-nav a:focus-visible { color: var(--text); background: rgba(237, 231, 220, 0.05); box-shadow: inset 0 0 0 2px var(--accent); }
  .main-nav a.active, .main-nav a.active:hover, .main-nav a.active:focus-visible { color: #fff; background: var(--accent); } /* the old red band, as a solid active state */
  .lang-switch { display: flex; gap: var(--s-1); align-items: center; }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s var(--ease);
  }
  .lang-switch a:hover { background: rgba(237, 231, 220, 0.06); }
  .lang-switch img {
    width: 24px;
    height: 16px;
    object-fit: cover;
    border-radius: 3px;
    opacity: 0.7;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: opacity 0.2s var(--ease), outline-color 0.2s var(--ease);
  }
  .lang-switch a:hover img, .lang-switch a.active img { opacity: 1; }
  .lang-switch a.active img { outline-color: var(--accent); }
  /* "Support" in the top bar: secondary and quieter than the active tab (outline, muted text) */
  .topbar-support.btn-secondary {
    min-height: 40px;
    padding: 0 1.4rem;
    gap: 0.5em;
    font-size: 1.35rem;
    color: var(--text-2);
    white-space: nowrap;
  }
  .topbar-support.btn-secondary:hover, .topbar-support.btn-secondary:focus-visible { color: #fff; }
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu-toggle .icon { width: 22px; height: 22px; }
  .menu-toggle .icon-close { display: none; }
  .topbar.is-open .menu-toggle .icon-open { display: none; }
  .topbar.is-open .menu-toggle .icon-close { display: block; }

  @media (max-width: 1023px) {
    .menu-toggle { display: inline-flex; }
    .topbar-inner { gap: var(--s-3); }
    .nav-panel {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: var(--s-3) var(--gutter) var(--s-5);
      background: var(--bg); /* opaque: nothing from the banner shows through */
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
      display: none;
    }
    .topbar.is-open .nav-panel { display: block; }
    .main-nav ul { flex-direction: column; align-items: stretch; gap: 0; }
    .main-nav a { width: 100%; min-height: 48px; font-size: 1.6rem; }
    .nav-panel::after { /* dim the page under the open menu */
      content: "";
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 100vh;
      background: rgba(0, 0, 0, 0.6);
      pointer-events: none;
    }
    .topbar-support.btn-secondary { display: flex; width: 100%; min-height: 48px; margin-top: var(--s-2); font-size: 1.5rem; }
    .nav-panel .lang-switch { margin-top: var(--s-3); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  }
  @media (min-width: 1024px) {
    .nav-panel { display: flex; align-items: center; gap: var(--s-4); }
    /* two-line lockup: the full name stays visible and leaves room for the menu, "Support" and flags in every language */
    .brand > span { font-size: 1.35rem; line-height: 1.15; letter-spacing: 0.08em; overflow: visible; }
    .brand-l2 { display: block; }
  }
  @media (min-width: 1024px) and (max-width: 1180px) {
    .topbar-inner { gap: var(--s-3); }
    .nav-panel { gap: var(--s-2); }
    .main-nav a { padding: 0 0.8rem; letter-spacing: 0.05em; }
    .lang-switch a { width: 32px; }
  }
  @media (max-width: 380px) {
    .brand > span { display: none; }
  }

  /* ---------- Identity banner (image, logo, title, tagline, socials) ---------- */
  .site-header {
    position: relative;
    isolation: isolate;
    text-align: center;
    padding: var(--s-7) var(--gutter) var(--s-7);
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #0c0c0d;
    background-position: center 30%;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at center, rgba(17, 18, 20, 0.15) 0%, rgba(17, 18, 20, 0.6) 80%),
      linear-gradient(180deg, rgba(17, 18, 20, 0) 60%, var(--bg) 100%); /* lighter: the photo reads again */
  }
  .site-header img.logo {
    width: 132px;
    height: 132px;
    margin: 0 auto var(--s-4);
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.55));
  }
  .site-header h1 {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    line-height: 1.1;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
    margin-bottom: var(--s-3);
  }
  .site-header .tagline {
    max-width: 68ch;
    font-size: clamp(1.45rem, 1.6vw, 1.7rem);
    line-height: 1.6;
    color: #d6cfc4; /* on the darkened banner */
  }
  .header-social {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }
  .header-social a, .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(237, 231, 220, 0.06);
    border: 1px solid var(--line);
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .header-social a:hover, .footer-social a:hover,
  .header-social a:focus-visible, .footer-social a:focus-visible { background: rgba(237, 231, 220, 0.12); border-color: var(--accent); transform: translateY(-2px); }
  .header-social img, .footer-social img { width: 20px; height: 20px; object-fit: contain; }
  @media (max-width: 600px) {
    .site-header img.logo { width: 96px; height: 96px; }
    .header-social { display: none; } /* the same links are in "Follow us" and in the footer */
  }

  /* ---------- Content width ---------- */
  .page-wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: var(--s-7) var(--gutter) var(--s-8);
  }

  /* ---------- Footer in columns ---------- */
  footer {
    margin-top: var(--s-8);
    background: #0d0e10;
    border-top: 1px solid var(--line);
  }
  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: var(--s-8) var(--gutter) var(--s-6);
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--s-7) var(--s-6);
  }
  .footer-brand { display: grid; gap: var(--s-3); align-content: start; }
  .footer-brand .brand-line { display: flex; align-items: center; gap: var(--s-3); }
  .footer-brand img { width: 56px; height: 56px; }
  .footer-brand strong {
    font-family: 'Oswald', sans-serif;
    font-size: 1.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .footer-col h2 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--s-3);
  }
  .footer-col ul { display: grid; gap: var(--s-1); }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 32px;
    font-size: 1.5rem;
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }
  /* the accent red, lifted so it reads as text on the footer: 5.3:1 on #0d0e10 (#c8322a would be 3.6:1) */
  .footer-col a:hover, .footer-col a:focus-visible { color: var(--accent-link); }
  .footer-social { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .footer-bottom {
    max-width: var(--max);
    margin: 0 auto;
    padding: var(--s-4) var(--gutter) var(--s-5);
    border-top: 1px solid var(--line);
  }
  .footer-bottom p { font-size: 1.35rem; color: var(--text-3); }
  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr 1fr; gap: var(--s-6) var(--s-4); }
    .footer-col:last-child { grid-column: 1 / -1; }
  }

  /* ---------- Discreet reveal on scroll, CSS only ---------- */
  @supports (animation-timeline: view()) {
    .reveal {
      animation: reveal-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 35%;
    }
  }
  /* Never fully hidden: content stays readable for screenshots, crawlers and slow scrolls. */
  @keyframes reveal-in {
    from { opacity: 0.35; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
  /* The reading progress follows the visitor's own scroll, it is not decorative motion: it stays on. */
  @media (prefers-reduced-motion: reduce) {
    @supports (animation-timeline: scroll()) {
      .topbar::after {
        animation: read-progress linear both !important;
        animation-timeline: scroll(root block) !important;
      }
    }
  }
  </style>
</head>

<body>
  <header class="topbar" data-topbar>
    <div class="topbar-inner">
      <a class="brand" href={`/${lang}`}>
        <img src="/brand/logo-160.webp" width="40" height="40" alt="" />
        <span>People's Republic <span class="brand-l2">Of Bulgaria</span></span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Menu" data-menu-toggle>
        <svg class="icon icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="icon icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>

      <div class="nav-panel" id="nav-panel">
        <nav class="main-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} class={active === item.key ? "active" : ""} aria-current={active === item.key ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <a class="btn-secondary topbar-support" href={BUY_ME_A_COFFEE_URL} target="_blank" rel="noopener">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9z" /><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17" /><path d="M8 3v2M12 3v2" /></svg>
          {ns.support}
          <span class="sr-only">({ns.newTab})</span>
        </a>

        <div class="lang-switch">
          <a href="/en" class={lang === "en" ? "active" : ""} data-lang-switch="en" hreflang="en" aria-current={lang === "en" ? "true" : undefined}>
            <img src="/png/128px-Flag_of_the_United_Kingdom.png" alt="EN" width="24" height="16" />
          </a>
          <a href="/fr" class={lang === "fr" ? "active" : ""} data-lang-switch="fr" hreflang="fr" aria-current={lang === "fr" ? "true" : undefined}>
            <img src="/png/128px-Flag_of_France.png" alt="FR" width="24" height="16" />
          </a>
          <a href="/es" class={lang === "es" ? "active" : ""} data-lang-switch="es" hreflang="es" aria-current={lang === "es" ? "true" : undefined}>
            <img src="/png/128px-Flag_of_Spain.png" alt="ES" width="24" height="16" />
          </a>
          <a href="/bg" class={lang === "bg" ? "active" : ""} data-lang-switch="bg" hreflang="bg" aria-current={lang === "bg" ? "true" : undefined}>
            <img src="/png/128px-Flag_of_Bulgaria.png" alt="BG" width="24" height="16" />
          </a>
        </div>
      </div>
    </div>
  </header>

  <div class="site-header" style={heroStyle}>
    <img class="logo" src="/brand/logo-320.webp" srcset="/brand/logo-160.webp 160w, /brand/logo-320.webp 320w" sizes="132px" width="132" height="132" alt="People's Republic Of Bulgaria" />
    <h1>People's Republic Of Bulgaria</h1>
    <p class="tagline">{t.home.tagline}</p>
    <div class="header-social">
      <a href="https://www.facebook.com/PeoplesRepublicOfBulgaria/" target="_blank" rel="noopener noreferrer">
        <img src="/png/icons/facebook-64.webp" alt="Facebook" width="20" height="20" />
      </a>
      <a href="https://www.instagram.com/peoplesrepublicofbulgaria/" target="_blank" rel="noopener noreferrer">
        <img src="/png/icons/instagram-64.webp" alt="Instagram" width="20" height="20" />
      </a>
      <a href="https://www.youtube.com/@PeoplesRepublicOfBulgaria1505" target="_blank" rel="noopener noreferrer">
        <img src="/png/icons/youtube-64.webp" alt="YouTube" width="20" height="20" />
      </a>
      <a href="https://www.tiktok.com/@peoplesrepublicof70" target="_blank" rel="noopener noreferrer">
        <img src="/png/icons/tiktok-64.webp" alt="TikTok" width="20" height="20" />
      </a>
    </div>
  </div>

  <main class="page-wrap">
    <slot />
    {showNextSteps && <NextSteps lang={lang as Lang} page={page} compact />}
  </main>

  <footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="brand-line">
          <img src="/brand/logo-160.webp" width="56" height="56" alt="" loading="lazy" decoding="async" />
          <strong>People's Republic Of Bulgaria</strong>
        </div>
      </div>

      <div class="footer-col">
        <h2>{t.home.explore}</h2>
        <ul>
          {nav.map((item) => (<li><a href={item.href}>{item.label}</a></li>))}
        </ul>
      </div>

      <div class="footer-col">
        <h2>{t.nav.contact}</h2>
        <ul>
          {footer.links.map((item) => (<li><a href={item.href}>{item.label}</a></li>))}
          <li><a href={`/${lang}#newsletter`}>Newsletter</a></li>
          <li>
            <a href={BUY_ME_A_COFFEE_URL} target="_blank" rel="noopener noreferrer">
